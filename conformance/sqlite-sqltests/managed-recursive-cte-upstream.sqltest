@database :memory:

# Unchanged SQL and result values from SQLite's test/with1.test.

test upstream-with2-8-2-union-distinct {
    CREATE TABLE t7(y);
    INSERT INTO t7 VALUES(NULL);
    CREATE VIEW v AS SELECT * FROM t7 ORDER BY y;

    WITH q(a) AS (
      SELECT 1
      UNION
      SELECT a+1 FROM q, v WHERE a<5
    )
    SELECT * FROM q;
}
expect {
    1
    2
    3
    4
    5
}

test upstream-with1-6-4-linear-counter {
    WITH x(i) AS (
      SELECT 1
      UNION ALL
      SELECT i+1 FROM x WHERE i<10
    )
    SELECT count(*) FROM x;
}
expect {
    10
}
