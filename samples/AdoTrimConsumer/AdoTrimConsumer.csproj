<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runnable ADO-only trim/AOT consumer.

    References only Devolutions.Ahtola.Data.Sqlite (which brings Devolutions.Ahtola.Core and the
    embedded Devolutions.Ahtola.Data). No Entity Framework Core, so the whole closure is expected
    to trim and AOT-compile with zero IL2xxx/IL3xxx warnings, and the published binary is actually
    executed by scripts/Invoke-TrimAnalysisGate.ps1 — that is what proves the schema table, the
    annotated GetFieldType contract and the tuple accumulator still work after trimming and after
    NativeAOT compilation, rather than merely analysing cleanly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AhtolaPackageVersion Condition="'$(AhtolaPackageVersion)' == ''">0.0.0-managed-local</AhtolaPackageVersion>
    <!-- The gate reads granular, unsuppressed trim/AOT warnings; never hide them here. -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>false</SuppressAotAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Devolutions.Ahtola.Data.Sqlite" Version="$(AhtolaPackageVersion)" />
  </ItemGroup>
</Project>
